# Public browser-safe credentials from the Supabase project's Connect dialog.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Canonical website origin, without a trailing path; set your HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional Turnstile. Configure its secret in Supabase dashboard, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional licensed OSM-derived raster provider. Blank uses public OSM tiles.
# HTTPS template must contain {z}, {x}, {y}. Include provider-required attribution.
# Browser keys are public: restrict them to your website in the provider dashboard.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
# Google client ID and secret belong in the Supabase provider dashboard.
